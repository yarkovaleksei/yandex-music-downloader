{
  "extends": "../../tsconfig.tests.json",
  "compilerOptions": {
    "composite": false,
    "noEmit": true
  },
  "include": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/test/**/*",
    "src/**/tests/**/*",
    "src/**/__tests__/**/*",
    "src/**/e2e/**/*",
    "src/**/fixtures/**/*"
  ]
}
