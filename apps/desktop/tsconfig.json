{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/**/test/**",
    "src/**/tests/**",
    "src/**/__tests__/**",
    "src/**/e2e/**",
    "src/**/fixtures/**"
  ],
  "references": [
    {
      "path": "../../packages/application"
    }
  ]
}
