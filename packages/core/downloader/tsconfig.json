{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist"
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.spec.ts",
    "src/**/test/**",
    "src/**/tests/**",
    "src/**/__tests__/**",
    "src/**/e2e/**",
    "src/**/fixtures/**"
  ],
  "references": [
    {
      "path": "../../shared"
    },
    {
      "path": "../validation"
    }
  ]
}
